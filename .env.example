# ------------------------------------------------------------------------------
# Shieldgrid MCP Configuration
# ------------------------------------------------------------------------------

# The absolute URL of the Shieldgrid core API instance.
# Default: http://localhost:3000/api/v1
SHIELDGRID_API_URL=http://localhost:3000/api/v1

# The required static service token to authenticate requests from core-mcp to shieldgrid-core.
# This MUST match one of the tokens configured in API_TOKENS on the core service.
# DO NOT commit real tokens here!
SHIELDGRID_API_TOKEN=your-secure-token-here
